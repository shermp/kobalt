cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
set(output "${OUTPUT}")
if(EXISTS "${output}")
    message(FATAL_ERROR "Source-bundle test scratch remains: ${output}")
endif()
file(MAKE_DIRECTORY "${output}/bundle")
file(WRITE "${output}/bundle/archive" "source fixture\n")
file(SHA256 "${output}/bundle/archive" hash)
file(WRITE "${output}/bundle/manifest.json"
    "{\"component\":\"kobalt-webkit\",\"archives\":{\"wpewebkit\":{\"path\":\"archive\",\"sha256\":\"${hash}\"}}}\n")
file(WRITE "${output}/bundle/SHA256SUMS" "${hash}  archive\n")
function(check action expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DACTION=${action}" "-DSOURCE_BUNDLE=${output}/bundle"
        -P "${root}/platforms/webkit/sources.cmake" RESULT_VARIABLE status
        OUTPUT_VARIABLE result ERROR_VARIABLE error)
    if(expected STREQUAL "pass")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Valid source bundle rejected: ${result}\n${error}")
        endif()
    elseif(status EQUAL 0 OR NOT "${result}\n${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${result}\n${error}")
    endif()
endfunction()
check(VERIFY pass)
check(IMPORT "does not match this recipe")
file(APPEND "${output}/bundle/archive" "corruption")
check(IMPORT "Bundled source checksum mismatch")
file(REMOVE "${output}/bundle/archive")
check(VERIFY "Missing or escaping source archive")
file(WRITE "${output}/outside" "source fixture\n")
file(CREATE_LINK "${output}/outside" "${output}/bundle/archive" SYMBOLIC)
check(IMPORT "Missing or escaping source archive")
file(REMOVE "${output}/bundle/archive")
file(WRITE "${output}/bundle/archive" "source fixture\n")
file(WRITE "${output}/bundle/SHA256SUMS" "${hash}  ../outside\n")
check(VERIFY "Unsafe source checksum path")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPATHS=${output}" -P "${root}/platforms/cleanup.cmake"
    COMMAND_ERROR_IS_FATAL ANY)

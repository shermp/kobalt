cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/platforms/webkit/notices.cmake")
if(CASE STREQUAL "broken")
    kobalt_webkit_notice_header("${OUTPUT}/broken.c" header)
    message(FATAL_ERROR "Broken notice was accepted")
endif()
if(EXISTS "${OUTPUT}")
    message(FATAL_ERROR "Notice test scratch remains: ${OUTPUT}")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(WRITE "${OUTPUT}/block.c" "/* editor mode */\n/* Copyright test; License test */\n#include <stdio.h>\n")
kobalt_webkit_notice_header("${OUTPUT}/block.c" header)
if(NOT header STREQUAL "/* editor mode */\n/* Copyright test; License test */\n")
    message(FATAL_ERROR "Multiple leading comments were lost: ${header}")
endif()
file(WRITE "${OUTPUT}/line.h" "// Copyright test\n// License test; retain punctuation\n\n#define FIXTURE 1\n")
kobalt_webkit_notice_header("${OUTPUT}/line.h" header)
if(NOT header STREQUAL "// Copyright test\n// License test; retain punctuation\n")
    message(FATAL_ERROR "Line-comment notice changed: ${header}")
endif()
file(WRITE "${OUTPUT}/broken.c" "/* Copyright truncated")
execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=broken "-DOUTPUT=${OUTPUT}"
    -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "Unterminated notice header")
    message(FATAL_ERROR "Truncated notice accepted: ${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPATHS=${OUTPUT}" -P "${root}/platforms/cleanup.cmake"
    COMMAND_ERROR_IS_FATAL ANY)

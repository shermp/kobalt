cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(build "${root}/build/webkit")
set(tc "$ENV{KOBALT_WEBKIT_TOOLCHAIN}")
set(readelf "${tc}/bin/arm-kobov5-linux-gnueabihf-readelf")
set(strip "${tc}/bin/arm-kobov5-linux-gnueabihf-strip")
set(sysroot /opt/wpe-armhf-sysroot)
if(NOT EXISTS "${KOBALT_WEBKIT_PREFIX}/lib/libWPEWebKit-2.0.so")
    message(FATAL_ERROR "Select the completed private WebKit prefix")
endif()
file(READ "${build}/dependency-entry.txt" entry)
string(STRIP "${entry}" entry)
if(NOT EXISTS "${entry}/complete")
    message(FATAL_ERROR "WebKit dependency set is not published")
endif()
set(inputs "${entry}")
foreach(path "${build}/arm/kobalt-webkit" "${build}/arm/kobalt-webkit-worker" "${build}/arm/kobalt-webkit-probe"
        "${CMAKE_CURRENT_LIST_FILE}" "${root}/platforms/webkit/notices.cmake"
        "${root}/platforms/webkit/notices.json" "${root}/platforms/webkit/acknowledgements.txt" "${root}/LICENSE" "${root}/assets/notices/Instrument-Serif-OFL" "${root}/assets/fonts/instrument-serif.json"
        "${root}/platforms/webkit/runtime-sources.json"
        "${root}/platforms/webkit/source-provenance.json" "${root}/tests/webkit/fixture.xhtml"
        "${root}/tests/webkit/illustration.svg" "${root}/assets/fonts/InstrumentSerif-Regular.ttf")
    file(SHA256 "${path}" hash)
    string(APPEND inputs ";${hash}")
endforeach()
string(SHA256 key "${inputs}")
set(output "${build}/packages/${key}/kobalt-webkit")
get_filename_component(parent "${output}" DIRECTORY)
if(EXISTS "${parent}/complete")
    execute_process(COMMAND sha256sum -c SHA256SUMS WORKING_DIRECTORY "${output}"
        OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND sha256sum -c kobalt-webkit-armhf.tar.sha256 WORKING_DIRECTORY "${parent}"
        OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
    file(WRITE "${build}/bundle.txt" "${output}\n")
    return()
endif()
if(EXISTS "${output}")
    message(FATAL_ERROR "Incomplete staging directory; clean with platforms/cleanup.cmake: ${output}")
endif()
set(roots "${KOBALT_WEBKIT_PREFIX}/lib" "${tc}/arm-kobov5-linux-gnueabihf/sysroot/lib"
    "${sysroot}/usr/lib/arm-linux-gnueabihf" "${sysroot}/lib/arm-linux-gnueabihf")
file(MAKE_DIRECTORY "${output}/bin" "${output}/private" "${output}/share/fixture" "${output}/share/licenses")
file(COPY "${build}/arm/kobalt-webkit" "${build}/arm/kobalt-webkit-worker" "${build}/arm/kobalt-webkit-probe" DESTINATION "${output}/bin")
file(COPY "${KOBALT_WEBKIT_PREFIX}/libexec" DESTINATION "${output}")
file(COPY "${KOBALT_WEBKIT_PREFIX}/lib/wpe-webkit-2.0" DESTINATION "${output}/lib")
file(COPY "${root}/tests/webkit/fixture.xhtml" "${root}/tests/webkit/illustration.svg" DESTINATION "${output}/share/fixture")
configure_file("${root}/assets/fonts/InstrumentSerif-Regular.ttf" "${output}/share/fixture/font.ttf" COPYONLY)
file(READ "${root}/assets/fonts/instrument-serif.json" font_manifest)
string(JSON font_count LENGTH "${font_manifest}" files)
math(EXPR font_last "${font_count} - 1")
set(verified_fonts)
foreach(index RANGE ${font_last})
    string(JSON name GET "${font_manifest}" files ${index} file)
    if(name STREQUAL "InstrumentSerif-Regular.ttf" OR name STREQUAL "../notices/Instrument-Serif-OFL")
        string(JSON expected GET "${font_manifest}" files ${index} sha256)
        file(SHA256 "${root}/assets/fonts/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Review fixture font/notice provenance: ${name}")
        endif()
        list(APPEND verified_fonts "${name}")
    endif()
endforeach()
if(NOT "InstrumentSerif-Regular.ttf" IN_LIST verified_fonts OR NOT "../notices/Instrument-Serif-OFL" IN_LIST verified_fonts)
    message(FATAL_ERROR "Missing fixture font/notice source pin")
endif()
configure_file("${root}/assets/notices/Instrument-Serif-OFL"
    "${output}/share/licenses/fonts/Instrument-Serif-OFL.txt" COPYONLY)
configure_file("${root}/assets/fonts/instrument-serif.json" "${output}/share/licenses/fonts/provenance.json" COPYONLY)
configure_file("${root}/LICENSE" "${output}/share/licenses/kobalt/LICENSE" COPYONLY)
file(GLOB_RECURSE queue LIST_DIRECTORIES FALSE "${output}/bin/*" "${output}/libexec/*" "${output}/lib/*")
set(seen)
set(manifest "")
set(packages "library\tbinary-package\tbinary-version\tsource-package\tsource-version\n")
set(abi "")
while(queue)
    list(POP_FRONT queue binary)
    execute_process(COMMAND "${readelf}" -h "${binary}" OUTPUT_VARIABLE header COMMAND_ERROR_IS_FATAL ANY)
    if(NOT header MATCHES "Class:[ \t]+ELF32" OR NOT header MATCHES "Machine:[ \t]+ARM"
       OR NOT header MATCHES "hard-float ABI")
        message(FATAL_ERROR "Not ARM32 hard-float: ${binary}")
    endif()
    execute_process(COMMAND "${readelf}" --version-info "${binary}" OUTPUT_VARIABLE versions COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "GLIBC_[0-9]+\\.[0-9]+(\\.[0-9]+)?" glibc "${versions}")
    foreach(version IN LISTS glibc)
        string(REPLACE "GLIBC_" "" number "${version}")
        if(number VERSION_GREATER 2.35)
            message(FATAL_ERROR "Firmware ABI exceeded by ${binary}: ${version}")
        endif()
    endforeach()
    execute_process(COMMAND "${readelf}" -l "${binary}" OUTPUT_VARIABLE program COMMAND_ERROR_IS_FATAL ANY)
    if(program MATCHES "interpreter:" AND NOT program MATCHES "interpreter: /lib/ld-linux-armhf.so.3")
        message(FATAL_ERROR "Unexpected ELF interpreter: ${binary}")
    endif()
    execute_process(COMMAND "${readelf}" -d "${binary}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" needed "${dynamic}")
    foreach(dependency IN LISTS needed)
        string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" name "${dependency}")
        if(name MATCHES "^(ld-linux-armhf\\.so\\.3|lib(c|m|pthread|dl|rt|resolv|util|anl)\\.so\\.[0-9]+|libnss_.*\\.so\\.[0-9]+)$"
           OR name IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${name}")
        find_file(resolved NAMES "${name}" PATHS ${roots} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
        if(NOT resolved)
            message(FATAL_ERROR "Unresolved private dependency ${name} from ${binary}")
        endif()
        file(SHA256 "${resolved}" hash)
        string(APPEND manifest "${name}\t${hash}\t${resolved}\n")
        cmake_path(IS_PREFIX KOBALT_WEBKIT_PREFIX "${resolved}" NORMALIZE from_webkit)
        cmake_path(IS_PREFIX tc "${resolved}" NORMALIZE from_compiler)
        if(from_webkit)
            string(APPEND packages "${name}\twpewebkit\t2.54.2\twpewebkit\t2.54.2\n")
        elseif(from_compiler)
            string(APPEND packages "${name}\tkobov5-runtime\t2026.08\tgcc\t14.4.0\n")
        else()
            file(RELATIVE_PATH original "${sysroot}" "${resolved}")
            execute_process(COMMAND dpkg-query -S "/${original}" OUTPUT_VARIABLE owner
                RESULT_VARIABLE attributed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            # Jammy's package database can retain /lib paths on a merged-/usr image.
            if(NOT attributed EQUAL 0 AND original MATCHES "^usr/lib/")
                string(REGEX REPLACE "^usr/" "" original "${original}")
                execute_process(COMMAND dpkg-query -S "/${original}" OUTPUT_VARIABLE owner
                    RESULT_VARIABLE attributed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            endif()
            if(NOT attributed EQUAL 0 OR NOT owner MATCHES "^([^ \n]+): /")
                message(FATAL_ERROR "Cannot attribute runtime library ${name}: ${owner}")
            endif()
            set(package "${CMAKE_MATCH_1}")
            execute_process(COMMAND dpkg-query -W
                "-f=\${binary:Package}\t\${Version}\t\${source:Package}\t\${source:Version}\n" "${package}"
                OUTPUT_VARIABLE provenance COMMAND_ERROR_IS_FATAL ANY)
            string(APPEND packages "${name}\t${provenance}")
        endif()
        # Kobo user storage is FAT: retain each needed SONAME as a regular file.
        file(COPY_FILE "${resolved}" "${output}/private/${name}")
        list(APPEND queue "${output}/private/${name}")
        unset(resolved)
    endforeach()
    file(REAL_PATH "${binary}" physical)
    cmake_path(IS_PREFIX output "${physical}" NORMALIZE inside)
    if(NOT inside)
        message(FATAL_ERROR "Refusing to strip outside staging")
    endif()
    execute_process(COMMAND "${strip}" --strip-unneeded "${physical}" COMMAND_ERROR_IS_FATAL ANY)
    file(RELATIVE_PATH relative "${output}" "${binary}")
    string(APPEND abi "${relative}\n${header}\n${program}\n${versions}\n")
endwhile()
file(WRITE "${output}/library-inputs.tsv" "${manifest}")
file(WRITE "${output}/library-packages.tsv" "${packages}")
file(WRITE "${output}/elf-audit.txt" "${abi}")
# Retain exact package notices, not just license labels. The complete source
# distribution audit is a release gate, documented in doc/webkit-wpe/m1.md.
file(GLOB_RECURSE package_notices LIST_DIRECTORIES FALSE "${sysroot}/usr/share/doc/*/copyright")
foreach(path IN LISTS package_notices)
    file(RELATIVE_PATH name "${sysroot}/usr/share/doc" "${path}")
    configure_file("${path}" "${output}/share/licenses/ubuntu/${name}" COPYONLY)
endforeach()
file(GLOB_RECURSE gcc_notices LIST_DIRECTORIES FALSE "${tc}/share/licenses/*")
foreach(path IN LISTS gcc_notices)
    file(RELATIVE_PATH name "${tc}" "${path}")
    configure_file("${path}" "${output}/share/licenses/toolchain/${name}" COPYONLY)
endforeach()
set(source "${entry}/sources/wpewebkit")
file(GLOB_RECURSE notices LIST_DIRECTORIES FALSE "${source}/*LICENSE*" "${source}/*COPYING*"
    "${source}/*NOTICE*" "${source}/*AUTHORS*" "${source}/*COPYRIGHT*")
foreach(path IN LISTS notices)
    file(RELATIVE_PATH name "${source}" "${path}")
    configure_file("${path}" "${output}/share/licenses/webkit/${name}" COPYONLY)
endforeach()
file(READ "${root}/platforms/webkit/notices.json" notice_manifest)
string(JSON reviewed_source GET "${notice_manifest}" webkit_source_sha256)
file(READ "${root}/dependencies/webkit/sources.json" source_pins)
string(JSON selected_source GET "${source_pins}" wpewebkit sha256)
if(NOT reviewed_source STREQUAL selected_source)
    message(FATAL_ERROR "Review enabled-component notices for the selected WebKit source")
endif()
include("${root}/platforms/webkit/notices.cmake")
kobalt_webkit_header_notices("${source}" "${output}/share/licenses/webkit-header-notices.txt"
    "${root}/platforms/webkit/notices.json")
configure_file("${root}/platforms/webkit/acknowledgements.txt" "${output}/ACKNOWLEDGEMENTS.txt" COPYONLY)
configure_file("${root}/platforms/webkit/notices.json" "${output}/share/licenses/header-notice-inputs.json" COPYONLY)
# BSD headers on changed upstream files are themselves distribution notices.
# Retain them explicitly alongside the release's component-level licenses.
file(GLOB patches "${root}/dependencies/webkit/patches/*.patch")
foreach(patch IN LISTS patches)
    file(STRINGS "${patch}" changed REGEX "^\\+\\+\\+ b/")
    get_filename_component(patch_name "${patch}" NAME)
    foreach(line IN LISTS changed)
        string(REGEX REPLACE "^\\+\\+\\+ b/" "" path "${line}")
        file(READ "${source}/${path}" contents)
        string(FIND "${contents}" "*/" end)
        if(NOT contents MATCHES "^/\\*" OR end LESS 0)
            message(FATAL_ERROR "Review missing upstream license header: ${path}")
        endif()
        math(EXPR length "${end} + 2")
        string(SUBSTRING "${contents}" 0 ${length} notice)
        get_filename_component(directory "${output}/share/licenses/webkit-modifications/${path}.txt" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${output}/share/licenses/webkit-modifications/${path}.txt"
            "${notice}\n\nKobalt modification: ${patch_name}; source and patch included in the matching source bundle.\n")
    endforeach()
endforeach()
execute_process(COMMAND dpkg-query -W "-f=\${binary:Package}\t\${Version}\t\${source:Package}\t\${source:Version}\n"
    OUTPUT_FILE "${output}/build-packages.tsv" COMMAND_ERROR_IS_FATAL ANY)
file(COPY "${root}/dependencies/webkit/build-image.json" "${root}/dependencies/webkit/sources.json"
    "${root}/dependencies/webkit/host-tools.json" "${root}/platforms/webkit/runtime-sources.json"
    "${root}/platforms/webkit/source-provenance.json" DESTINATION "${output}")
file(WRITE "${output}/distribution-status.txt"
    "M1 development artifact. Exact corresponding-source pins and component notices are included; pair the complete matching source bundle and its selected-configuration audit. Release publication, required-mode isolation and physical-device validation are separate from these development results.\n")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${output}" "${output}/*")
list(SORT files)
set(checksums "")
foreach(path IN LISTS files)
    file(SHA256 "${output}/${path}" hash)
    string(APPEND checksums "${hash}  ${path}\n")
endforeach()
file(WRITE "${output}/SHA256SUMS" "${checksums}")
file(READ "${root}/dependencies/webkit/build-image.json" lock)
string(JSON epoch GET "${lock}" source_date_epoch)
execute_process(COMMAND tar --sort=name "--mtime=@${epoch}" --owner=0 --group=0 --numeric-owner
    -cf "${parent}/kobalt-webkit-armhf.tar" kobalt-webkit WORKING_DIRECTORY "${parent}"
    COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${parent}/kobalt-webkit-armhf.tar" hash)
file(WRITE "${parent}/kobalt-webkit-armhf.tar.sha256" "${hash}  kobalt-webkit-armhf.tar\n")
file(WRITE "${parent}/complete" "${key}\n")
file(WRITE "${build}/bundle.txt" "${output}\n")
message(STATUS "Development renderer bundle: ${output}")

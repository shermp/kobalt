#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export LD_LIBRARY_PATH="$root/lib" WEBKIT_EXEC_PATH="$root/libexec"
export WEBKIT_INJECTED_BUNDLE_PATH="$root/lib" WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export LIBGL_DRIVERS_PATH=/nonexistent __EGL_VENDOR_LIBRARY_FILENAMES=/nonexistent
exec "$root/bin/wpe-socket-renderer" "$@"

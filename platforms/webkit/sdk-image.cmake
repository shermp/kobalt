# Offline recovery of the exact prepared WebKit SDK, never a replacement Qt SDK.
cmake_minimum_required(VERSION 3.22)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
include("${root}/dependencies/cache.cmake")
file(READ "${root}/dependencies/webkit/build-image.json" build_lock)
string(JSON image GET "${build_lock}" image)
string(JSON platform GET "${build_lock}" platform)
set(lock_file "${CMAKE_CURRENT_LIST_DIR}/sdk-archive.json")
set(engine "$ENV{CONTAINER_ENGINE}")
if(NOT engine)
    set(engine podman)
endif()
if(NOT ACTION MATCHES "^(EXPORT|VERIFY|RESTORE)$")
    message(FATAL_ERROR "Set ACTION=EXPORT, VERIFY or RESTORE")
endif()
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
set(scratch "${root}/build/webkit/sdk-recovery")
file(MAKE_DIRECTORY "${scratch}")

# The complete archive hash protects every blob. Also check its OCI manifest's
# config identity so an accidental export of another image cannot establish a pin.
function(check_image archive)
    execute_process(COMMAND tar -xOf "${archive}" index.json
        OUTPUT_VARIABLE index COMMAND_ERROR_IS_FATAL ANY)
    string(JSON count LENGTH "${index}" manifests)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one SDK image in the OCI archive")
    endif()
    string(JSON digest GET "${index}" manifests 0 digest)
    string(LENGTH "${digest}" length)
    if(NOT digest MATCHES "^sha256:[0-9a-f]+$" OR NOT length EQUAL 71)
        message(FATAL_ERROR "Invalid OCI manifest digest")
    endif()
    string(SUBSTRING "${digest}" 7 -1 hash)
    execute_process(COMMAND tar -xOf "${archive}" "blobs/sha256/${hash}"
        OUTPUT_VARIABLE manifest COMMAND_ERROR_IS_FATAL ANY)
    string(SHA256 actual "${manifest}")
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "OCI manifest checksum mismatch")
    endif()
    string(JSON config GET "${manifest}" config digest)
    if(NOT config STREQUAL image)
        message(FATAL_ERROR "SDK archive contains ${config}, expected ${image}")
    endif()
    string(SUBSTRING "${config}" 7 -1 hash)
    execute_process(COMMAND tar -xOf "${archive}" "blobs/sha256/${hash}"
        OUTPUT_VARIABLE configuration COMMAND_ERROR_IS_FATAL ANY)
    string(SHA256 actual "${configuration}")
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "OCI config checksum mismatch")
    endif()
    string(JSON architecture GET "${configuration}" architecture)
    string(JSON os GET "${configuration}" os)
    if(NOT "${os}/${architecture}" STREQUAL platform)
        message(FATAL_ERROR "SDK archive is not ${platform}")
    endif()
endfunction()

if(ACTION STREQUAL "EXPORT")
    execute_process(COMMAND "${engine}" ${ENGINE_ARGS} image inspect "${image}" --format "{{.Id}}"
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT actual MATCHES "^sha256:")
        string(PREPEND actual "sha256:")
    endif()
    if(NOT actual STREQUAL image)
        message(FATAL_ERROR "Prepared SDK identity mismatch")
    endif()
    string(RANDOM LENGTH 12 token)
    set(partial "${scratch}/image-${token}.partial")
    execute_process(COMMAND "${engine}" ${ENGINE_ARGS} save --format oci-archive --output "${partial}" "${image}"
        COMMAND_ERROR_IS_FATAL ANY)
    check_image("${partial}")
    file(SHA256 "${partial}" hash)
    kobalt_dependency_archive("${cache}/downloads" webkit-sdk "${partial}" "${hash}" archive)
    set(candidate "{\n  \"image\": \"${image}\",\n  \"format\": \"oci-archive\",\n  \"sha256\": \"${hash}\"\n}\n")
    file(WRITE "${scratch}/sdk-archive.json" "${candidate}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPATHS=${partial}" -P "${root}/platforms/cleanup.cmake"
        COMMAND_ERROR_IS_FATAL ANY)
    message(STATUS "SDK recovery archive: ${archive}")
    message(STATUS "Review pin: ${scratch}/sdk-archive.json")
    return()
endif()

if(NOT EXISTS "${lock_file}")
    message(FATAL_ERROR "No reviewed SDK archive pin; export the prepared image first")
endif()
file(READ "${lock_file}" lock)
string(JSON locked_image GET "${lock}" image)
string(JSON hash GET "${lock}" sha256)
string(JSON format GET "${lock}" format)
if(NOT locked_image STREQUAL image OR NOT format STREQUAL "oci-archive")
    message(FATAL_ERROR "SDK recovery pin does not match the build image")
endif()
if(NOT ARCHIVE)
    set(ARCHIVE "${cache}/downloads/webkit-sdk-${hash}.tar")
endif()
if(NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "Missing SDK recovery archive: ${ARCHIVE}")
endif()
file(SHA256 "${ARCHIVE}" actual)
if(NOT actual STREQUAL hash)
    message(FATAL_ERROR "SDK recovery archive checksum mismatch")
endif()
check_image("${ARCHIVE}")
if(ACTION STREQUAL "RESTORE")
    # Loading is explicit. Never pull, rebuild or replace an installed SDK.
    execute_process(COMMAND "${engine}" ${ENGINE_ARGS} image inspect "${image}"
        RESULT_VARIABLE exists OUTPUT_QUIET ERROR_QUIET)
    if(NOT exists EQUAL 0)
        execute_process(COMMAND "${engine}" ${ENGINE_ARGS} load --input "${ARCHIVE}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
    execute_process(COMMAND "${engine}" ${ENGINE_ARGS} image inspect "${image}" --format "{{.Id}}"
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT actual MATCHES "^sha256:")
        string(PREPEND actual "sha256:")
    endif()
    if(NOT actual STREQUAL image)
        message(FATAL_ERROR "Restored SDK identity mismatch")
    endif()
endif()
message(STATUS "Verified offline SDK archive for ${image}")

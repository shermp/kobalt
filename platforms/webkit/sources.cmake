# Corresponding source material for the standalone renderer, using the shared cache.
cmake_minimum_required(VERSION 3.22)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
include("${root}/dependencies/cache.cmake")
if(NOT ACTION MATCHES "^(FETCH|EXPORT|VERIFY|IMPORT)$")
    message(FATAL_ERROR "Set ACTION=FETCH, EXPORT, VERIFY or IMPORT")
endif()
set(bundle "$ENV{KOBALT_WEBKIT_SOURCE_BUNDLE}")
if(SOURCE_BUNDLE)
    set(bundle "${SOURCE_BUNDLE}")
endif()

function(verify_bundle)
    if(NOT IS_ABSOLUTE "${bundle}" OR NOT EXISTS "${bundle}/manifest.json")
        message(FATAL_ERROR "Supply an absolute SOURCE_BUNDLE with manifest.json")
    endif()
    file(REAL_PATH "${bundle}" base)
    file(READ "${base}/manifest.json" manifest)
    string(JSON component GET "${manifest}" component)
    if(NOT component STREQUAL "kobalt-webkit")
        message(FATAL_ERROR "Not a WebKit source bundle")
    endif()
    string(JSON count LENGTH "${manifest}" archives)
    if(count LESS 1)
        message(FATAL_ERROR "Source bundle has no archives")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON name MEMBER "${manifest}" archives ${index})
        string(JSON path GET "${manifest}" archives "${name}" path)
        string(JSON hash GET "${manifest}" archives "${name}" sha256)
        if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR path MATCHES ";")
            message(FATAL_ERROR "Unsafe source archive path: ${path}")
        endif()
        file(REAL_PATH "${base}/${path}" physical)
        cmake_path(IS_PREFIX base "${physical}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${physical}" OR IS_DIRECTORY "${physical}")
            message(FATAL_ERROR "Missing or escaping source archive: ${path}")
        endif()
        file(SHA256 "${physical}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "Bundled source checksum mismatch: ${name}")
        endif()
    endforeach()
    set(bundle_manifest "${manifest}" PARENT_SCOPE)
endfunction()

if(ACTION STREQUAL "VERIFY" OR ACTION STREQUAL "IMPORT")
    if(ACTION STREQUAL "IMPORT" AND NOT bundle)
        return()
    endif()
    verify_bundle()
    if(ACTION STREQUAL "VERIFY")
        # This checks the pristine first-party files too. IMPORT deliberately
        # allows the recipient to modify application sources and patch recipes.
        file(REAL_PATH "${bundle}" base)
        file(STRINGS "${bundle}/SHA256SUMS" checksums)
        foreach(line IN LISTS checksums)
            if(NOT line MATCHES "^[0-9a-f]+  (.+)$")
                message(FATAL_ERROR "Malformed source checksum record")
            endif()
            set(path "${CMAKE_MATCH_1}")
            if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR path MATCHES ";")
                message(FATAL_ERROR "Unsafe source checksum path")
            endif()
            file(REAL_PATH "${base}/${path}" physical)
            cmake_path(IS_PREFIX base "${physical}" NORMALIZE inside)
            if(NOT inside)
                message(FATAL_ERROR "Escaping source checksum path")
            endif()
        endforeach()
        execute_process(COMMAND sha256sum -c SHA256SUMS WORKING_DIRECTORY "${bundle}"
            OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
    else()
        file(READ "${root}/dependencies/webkit/sources.json" pins)
        string(JSON expected GET "${pins}" wpewebkit sha256)
        string(JSON actual GET "${bundle_manifest}" archives wpewebkit sha256)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Source bundle WebKit does not match this recipe")
        endif()
        string(JSON path GET "${bundle_manifest}" archives wpewebkit path)
        kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
        kobalt_dependency_archive("${cache}/downloads" wpewebkit "${bundle}/${path}" "${expected}" archive)
    endif()
    message(STATUS "Verified WebKit source bundle: ${bundle}")
    return()
endif()

kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
file(READ "${CMAKE_CURRENT_LIST_DIR}/runtime-sources.json" manifest)
file(READ "${root}/dependencies/webkit/sources.json" pins)
string(JSON wpe GET "${pins}" wpewebkit)
string(JSON directory GET "${wpe}" directory)
string(REGEX REPLACE "^wpewebkit-" "" version "${directory}")
string(JSON wpe SET "${wpe}" filename "\"${directory}.tar.xz\"")
string(JSON wpe SET "${wpe}" source "\"wpewebkit\"")
string(JSON wpe SET "${wpe}" source_version "\"${version}\"")
string(JSON manifest SET "${manifest}" wpewebkit "${wpe}")
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON name MEMBER "${manifest}" ${index})
    string(JSON url GET "${manifest}" "${name}" url)
    string(JSON hash GET "${manifest}" "${name}" sha256)
    set(archive "${cache}/downloads/${name}-${hash}.tar")
    if(ACTION STREQUAL "FETCH")
        message(STATUS "Verifying source ${name}")
        kobalt_dependency_archive("${cache}/downloads" "${name}" "${url}" "${hash}" archive)
    else()
        if(NOT EXISTS "${archive}")
            message(FATAL_ERROR "Missing cached source ${name}; run ACTION=FETCH explicitly first")
        endif()
        file(SHA256 "${archive}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "Cached source checksum mismatch: ${name}")
        endif()
    endif()
endforeach()
if(ACTION STREQUAL "FETCH")
    return()
endif()

if(NOT EXISTS "${root}/build/webkit/bundle.txt" OR NOT EXISTS "${root}/build/webkit/kobov5.txt")
    message(FATAL_ERROR "Build the renderer before exporting its corresponding sources")
endif()

# Export only this component and its fixture. Binary SDKs are separately pinned
# build inputs; the local recovery archive is not a public redistribution bundle.
if(NOT OUTPUT)
    set(OUTPUT "${root}/build/webkit/sources/kobalt-webkit-sources")
endif()
set(output "${OUTPUT}")
set(build_root "${root}/build")
cmake_path(IS_PREFIX build_root "${output}" NORMALIZE inside)
if(NOT inside OR output STREQUAL build_root)
    message(FATAL_ERROR "Source exports must stay under this worktree build directory")
endif()
if(EXISTS "${output}")
    message(FATAL_ERROR "Choose a clean source staging directory with platforms/cleanup.cmake: ${output}")
endif()
file(MAKE_DIRECTORY "${output}/application/platforms" "${output}/application/dependencies"
    "${output}/application/src" "${output}/application/tests" "${output}/application/doc"
    "${output}/application/assets/fonts")
foreach(directory platforms/webkit dependencies/webkit src/webkit tests/webkit doc/webkit-wpe)
    get_filename_component(parent "${directory}" DIRECTORY)
    file(COPY "${root}/${directory}" DESTINATION "${output}/application/${parent}")
endforeach()
foreach(path LICENSE .clang-format dependencies/cache.cmake dependencies/apply-patches.cmake
        platforms/cleanup.cmake platforms/load-lock.cmake assets/fonts/InstrumentSerif-Regular.ttf assets/fonts/OFL.txt)
    configure_file("${root}/${path}" "${output}/application/${path}" COPYONLY)
endforeach()
if(KOBALT_SOURCE_COMMIT)
    set(commit "${KOBALT_SOURCE_COMMIT}")
else()
    find_program(GIT_EXECUTABLE git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse HEAD
        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
file(WRITE "${output}/application/source-info.json"
    "{\n  \"component\": \"kobalt-webkit\",\n  \"base_commit\": \"${commit}\",\n  \"files\": \"See ../SHA256SUMS for exported working-source contents\"\n}\n")

set(export "{\"component\":\"kobalt-webkit\",\"archives\":{}}")
set(covered)
foreach(index RANGE ${last})
    string(JSON name MEMBER "${manifest}" ${index})
    string(JSON item GET "${manifest}" "${name}")
    string(JSON hash GET "${item}" sha256)
    string(JSON filename GET "${item}" filename)
    string(JSON source GET "${item}" source)
    string(JSON version GET "${item}" source_version)
    list(APPEND covered "${source}=${version}")
    if(name STREQUAL "wpewebkit")
        set(path "application/upstream/wpewebkit.archive")
        file(MAKE_DIRECTORY "${output}/application/upstream")
        file(WRITE "${output}/application/upstream/manifest.json" "{\"wpewebkit\":${wpe}}\n")
    elseif(name MATCHES "^ubuntu-")
        string(REPLACE ":" "_" directory_version "${version}")
        set(path "sources/ubuntu/${source}-${directory_version}/${filename}")
    else()
        set(path "sources/compiler/${filename}")
    endif()
    get_filename_component(parent "${output}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${cache}/downloads/${name}-${hash}.tar" "${output}/${path}")
    string(JSON item SET "${item}" path "\"${path}\"")
    string(JSON export SET "${export}" archives "${name}" "${item}")
endforeach()
file(WRITE "${output}/manifest.json" "${export}\n")

# The binary's exact mapping is required: a generic list of available sources is
# insufficient evidence of the sources for the libraries actually distributed.
file(READ "${root}/build/webkit/bundle.txt" runtime)
string(STRIP "${runtime}" runtime)
if(runtime MATCHES "^/work/")
    string(REGEX REPLACE "^/work/" "${root}/" runtime "${runtime}")
endif()
cmake_path(IS_PREFIX build_root "${runtime}" NORMALIZE own_runtime)
if(NOT own_runtime)
    message(FATAL_ERROR "Source export needs this worktree's renderer package")
endif()
file(STRINGS "${runtime}/library-packages.tsv" packages)
list(POP_FRONT packages)
foreach(row IN LISTS packages)
    string(REPLACE "\t" ";" fields "${row}")
    list(GET fields 3 package)
    list(GET fields 4 version)
    set(pair "${package}=${version}")
    if(NOT pair IN_LIST covered)
        message(FATAL_ERROR "No corresponding source for ${package} ${version}")
    endif()
endforeach()
file(COPY "${runtime}/library-packages.tsv" DESTINATION "${output}")
file(COPY "${runtime}/share/licenses" DESTINATION "${output}")
file(READ "${root}/build/webkit/kobov5.txt" toolchain)
string(STRIP "${toolchain}" toolchain)
if(toolchain MATCHES "^/work/")
    string(REGEX REPLACE "^/work/" "${root}/" toolchain "${toolchain}")
endif()
cmake_path(IS_PREFIX build_root "${toolchain}" NORMALIZE own_toolchain)
if(NOT own_toolchain)
    message(FATAL_ERROR "Source export needs this worktree's verified toolchain")
endif()
file(COPY "${toolchain}/share/arm-kobov5-linux-gnueabihf-ct-ng.config.bz2" "${toolchain}/build.log.bz2"
    DESTINATION "${output}/sources/compiler")
file(WRITE "${output}/SOURCE.txt"
    "Standalone Kobalt WebKit working sources based on ${commit}.\nVerify with cmake -DACTION=VERIFY -DSOURCE_BUNDLE=<absolute bundle root> -P application/platforms/webkit/sources.cmake.\nThe separate prepared SDK and verified kobov5/CMake binary tool archives are required to build. They are not included here.\nSee application/doc/webkit-wpe/m1.md for scope, licenses and unresolved production gates.\n")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${output}" "${output}/*" "${output}/application/.clang-format")
list(SORT files)
set(checksums "")
foreach(path IN LISTS files)
    file(SHA256 "${output}/${path}" hash)
    string(APPEND checksums "${hash}  ${path}\n")
endforeach()
file(WRITE "${output}/SHA256SUMS" "${checksums}")
file(READ "${root}/dependencies/webkit/build-image.json" lock)
string(JSON epoch GET "${lock}" source_date_epoch)
get_filename_component(parent "${output}" DIRECTORY)
get_filename_component(staging_name "${output}" NAME)
execute_process(COMMAND tar --sort=name "--mtime=@${epoch}" --owner=0 --group=0 --numeric-owner
    -cf "${parent}/kobalt-webkit-sources.tar" "${staging_name}" WORKING_DIRECTORY "${parent}"
    COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${parent}/kobalt-webkit-sources.tar" hash)
file(WRITE "${parent}/kobalt-webkit-sources.tar.sha256" "${hash}  kobalt-webkit-sources.tar\n")
message(STATUS "Standalone corresponding-source bundle: ${parent}/kobalt-webkit-sources.tar")

# Preserve notices carried only in leading C/C++ comments, including files with
# an editor-mode comment before the actual license and amalgamated // headers.
function(kobalt_webkit_notice_header path output)
    file(READ "${path}" remaining LIMIT 65536)
    set(header "")
    while(TRUE)
        string(REGEX REPLACE "^[ \t\r\n]+" "" remaining "${remaining}")
        if(remaining MATCHES "^/\\*")
            string(FIND "${remaining}" "*/" end)
            if(end LESS 0)
                message(FATAL_ERROR "Unterminated notice header: ${path}")
            endif()
            math(EXPR length "${end} + 2")
        elseif(remaining MATCHES "^//")
            string(FIND "${remaining}" "\n" length)
            if(length LESS 0)
                string(LENGTH "${remaining}" length)
            endif()
        else()
            break()
        endif()
        string(SUBSTRING "${remaining}" 0 ${length} comment)
        string(APPEND header "${comment}\n")
        string(SUBSTRING "${remaining}" ${length} -1 remaining)
    endwhile()
    set(${output} "${header}" PARENT_SCOPE)
endfunction()

function(kobalt_webkit_header_notices source output manifest)
    file(READ "${manifest}" groups)
    string(JSON count LENGTH "${groups}" header_groups)
    math(EXPR last "${count} - 1")
    set(index "Header-only notices from the pinned WebKit release. Pair this runtime with its complete corresponding-source bundle.\n")
    set(notices "")
    set(seen)
    foreach(group RANGE ${last})
        string(JSON name GET "${groups}" header_groups ${group} component)
        string(JSON license GET "${groups}" header_groups ${group} license)
        string(JSON patterns LENGTH "${groups}" header_groups ${group} patterns)
        math(EXPR final_pattern "${patterns} - 1")
        set(files)
        foreach(item RANGE ${final_pattern})
            string(JSON pattern GET "${groups}" header_groups ${group} patterns ${item})
            file(GLOB found LIST_DIRECTORIES FALSE "${source}/${pattern}")
            if(NOT found)
                message(FATAL_ERROR "Review missing notice input: ${pattern}")
            endif()
            list(APPEND files ${found})
        endforeach()
        list(REMOVE_DUPLICATES files)
        list(SORT files)
        string(APPEND index "\n${name}: ${license}\n")
        set(found_notice FALSE)
        foreach(path IN LISTS files)
            kobalt_webkit_notice_header("${path}" header)
            if(NOT header MATCHES "[Cc]opyright|[Ll]icen[cs]e|SPDX|[Pp]ublic [Dd]omain")
                continue()
            endif()
            set(found_notice TRUE)
            file(RELATIVE_PATH relative "${source}" "${path}")
            string(SHA256 hash "${header}")
            string(APPEND index "${relative}: ${hash}\n")
            if(NOT hash IN_LIST seen)
                list(APPEND seen "${hash}")
                string(APPEND notices "\nNotice ${hash}\n${header}\n")
            endif()
        endforeach()
        if(NOT found_notice)
            message(FATAL_ERROR "Review missing copyright/license header: ${name}")
        endif()
    endforeach()
    file(WRITE "${output}" "${index}\n${notices}")
endfunction()

cmake_minimum_required(VERSION 3.25)
if(NOT KOBALT_WEBKIT_BUILD_IMAGE OR NOT KOBALT_WEBKIT_OUTPUT_FILE)
    message(FATAL_ERROR "Set the exact ARM build image ID and a worktree output file")
endif()
if(NOT DEFINED ENV{KOBALT_WEBKIT_TOOLCHAIN})
    message(FATAL_ERROR "Set KOBALT_WEBKIT_TOOLCHAIN to the verified kobov5 toolchain")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
set(identity "webkit-m0-armhf;${KOBALT_WEBKIT_BUILD_IMAGE};${CMAKE_VERSION};lazy-egl=ON")
foreach(recipe sources.json wpe-options.cmake CMakeLists.txt build-arm.cmake arm.cmake
        kobov5.cmake Containerfile.arm host-tools.json lazy-wpe-egl.candidate.patch no-libdrm-snapshot.candidate.patch ../apply-patches.cmake ../cache.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" hash)
    string(APPEND identity ";${recipe}=${hash}")
endforeach()
string(SHA256 hash "${identity}")
set(key "webkit-m0-armhf-${hash}")
set(entry "${cache}/${key}")
get_filename_component(settings_directory "${KOBALT_WEBKIT_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${settings_directory}")
set(settings "")
kobalt_settings_line(settings KOBALT_WEBKIT_OUTPUT "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_DOWNLOADS "${cache}/downloads")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS 8)
kobalt_settings_line(settings KOBALT_WEBKIT_LAZY_EGL ON)
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake" "${settings}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")
# CMake propagates this environment into the isolated ExternalProject configure.
set(ENV{DESTDIR} "${entry}/install")
set(ENV{CMAKE_TOOLCHAIN_FILE} "${CMAKE_CURRENT_LIST_DIR}/arm.cmake")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}"
    "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake")

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(KOBALT_WEBKIT_TOOLCHAIN "$ENV{KOBALT_WEBKIT_TOOLCHAIN}" CACHE PATH "Verified kobov5 toolchain root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KOBALT_WEBKIT_TOOLCHAIN)
if(NOT IS_DIRECTORY "${KOBALT_WEBKIT_TOOLCHAIN}")
    message(FATAL_ERROR "Set KOBALT_WEBKIT_TOOLCHAIN to the verified kobov5 toolchain directory")
endif()
set(tc "${KOBALT_WEBKIT_TOOLCHAIN}")
set(CMAKE_C_COMPILER "${tc}/bin/arm-kobov5-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${tc}/bin/arm-kobov5-linux-gnueabihf-g++")
set(CMAKE_SYSROOT "${tc}/arm-kobov5-linux-gnueabihf/sysroot")
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard -mthumb")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard -mthumb")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

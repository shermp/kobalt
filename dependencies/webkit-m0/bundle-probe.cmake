cmake_minimum_required(VERSION 3.25)
foreach(required KOBALT_WEBKIT_PREFIX KOBALT_PROBE_BINARY KOBALT_BUNDLE_OUTPUT)
    if(NOT ${required})
        message(FATAL_ERROR "Set ${required}")
    endif()
endforeach()
set(tc "$ENV{KOBALT_WEBKIT_TOOLCHAIN}")
set(readelf "${tc}/bin/arm-kobov5-linux-gnueabihf-readelf")
set(strip "${tc}/bin/arm-kobov5-linux-gnueabihf-strip")
set(sysroot /opt/wpe-armhf-sysroot)
set(roots "${KOBALT_WEBKIT_PREFIX}/lib"
    "${tc}/arm-kobov5-linux-gnueabihf/sysroot/lib"
    "${sysroot}/usr/lib/arm-linux-gnueabihf" "${sysroot}/lib/arm-linux-gnueabihf")
if(EXISTS "${KOBALT_BUNDLE_OUTPUT}")
    message(FATAL_ERROR "Choose a fresh bundle output, or clean the previous experiment with platforms/cleanup.cmake")
endif()
file(MAKE_DIRECTORY "${KOBALT_BUNDLE_OUTPUT}/bin" "${KOBALT_BUNDLE_OUTPUT}/private")
file(COPY "${KOBALT_PROBE_BINARY}" DESTINATION "${KOBALT_BUNDLE_OUTPUT}/bin")
file(COPY "${KOBALT_WEBKIT_PREFIX}/libexec" DESTINATION "${KOBALT_BUNDLE_OUTPUT}")
file(COPY "${KOBALT_WEBKIT_PREFIX}/lib/wpe-webkit-2.0" DESTINATION "${KOBALT_BUNDLE_OUTPUT}/lib")
get_filename_component(probe_directory "${KOBALT_PROBE_BINARY}" DIRECTORY)
foreach(fixture fixture.xhtml illustration.svg font.ttf)
    file(COPY "${probe_directory}/${fixture}" DESTINATION "${KOBALT_BUNDLE_OUTPUT}")
endforeach()
file(GLOB_RECURSE queue LIST_DIRECTORIES FALSE "${KOBALT_BUNDLE_OUTPUT}/bin/*"
    "${KOBALT_BUNDLE_OUTPUT}/libexec/*" "${KOBALT_BUNDLE_OUTPUT}/lib/*")
set(seen)
set(manifest "")
while(queue)
    list(POP_FRONT queue binary)
    execute_process(COMMAND "${readelf}" -h "${binary}" OUTPUT_VARIABLE header COMMAND_ERROR_IS_FATAL ANY)
    if(NOT header MATCHES "Class:[ \t]+ELF32" OR NOT header MATCHES "Machine:[ \t]+ARM")
        message(FATAL_ERROR "Non-ARM32 input: ${binary}")
    endif()
    execute_process(COMMAND "${readelf}" -d "${binary}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" dependencies "${dynamic}")
    foreach(dependency IN LISTS dependencies)
        string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" name "${dependency}")
        # Retain firmware's complete libc/loader family; never bundle a replacement.
        if(name MATCHES "^(ld-linux-armhf\\.so\\.3|lib(c|m|pthread|dl|rt|resolv|util|anl)\\.so\\.[0-9]+|libnss_.*\\.so\\.[0-9]+)$"
           OR name IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${name}")
        unset(resolved)
        find_file(resolved NAMES "${name}" PATHS ${roots} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
        if(NOT resolved)
            message(FATAL_ERROR "Unresolved target dependency ${name} from ${binary}")
        endif()
        file(SHA256 "${resolved}" checksum)
        string(APPEND manifest "${name}\t${checksum}\t${resolved}\n")
        file(COPY "${resolved}" DESTINATION "${KOBALT_BUNDLE_OUTPUT}/private" FOLLOW_SYMLINK_CHAIN)
        list(APPEND queue "${KOBALT_BUNDLE_OUTPUT}/private/${name}")
    endforeach()
    get_filename_component(physical "${binary}" REALPATH)
    cmake_path(IS_PREFIX KOBALT_BUNDLE_OUTPUT "${physical}" NORMALIZE inside_output)
    if(NOT inside_output)
        message(FATAL_ERROR "Refusing to strip a file outside the copied bundle: ${physical}")
    endif()
    execute_process(COMMAND "${strip}" --strip-unneeded "${physical}" COMMAND_ERROR_IS_FATAL ANY)
endwhile()
file(WRITE "${KOBALT_BUNDLE_OUTPUT}/library-inputs.tsv" "${manifest}")
message(STATUS "ARM32 probe bundle: ${KOBALT_BUNDLE_OUTPUT}")

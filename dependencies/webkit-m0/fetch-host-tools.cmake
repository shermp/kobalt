cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
file(READ "${CMAKE_CURRENT_LIST_DIR}/host-tools.json" sources)
string(JSON url GET "${sources}" cmake-host url)
string(JSON hash GET "${sources}" cmake-host sha256)
string(JSON directory GET "${sources}" cmake-host directory)
kobalt_dependency_archive("${cache}/downloads" cmake-host "${url}" "${hash}" archive)
set(output "${root}/build/webkit-m0/host-tools")
if(NOT EXISTS "${output}/${directory}/.complete")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${output}")
    file(WRITE "${output}/${directory}/.complete" "${hash}\n")
endif()
message(STATUS "Verified CMake host tool: ${output}/${directory}/bin/cmake")

cmake_minimum_required(VERSION 3.24)
if(NOT KOBALT_WEBKIT_BUILD_IMAGE)
    message(FATAL_ERROR "Set KOBALT_WEBKIT_BUILD_IMAGE to the exact native build image ID")
endif()
if(NOT KOBALT_WEBKIT_OUTPUT_FILE)
    message(FATAL_ERROR "Set KOBALT_WEBKIT_OUTPUT_FILE to a worktree build output path")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
set(identity "webkit-m0-native;${KOBALT_WEBKIT_BUILD_IMAGE};${CMAKE_VERSION};lazy-egl=${KOBALT_WEBKIT_LAZY_EGL}")
foreach(recipe sources.json wpe-options.cmake CMakeLists.txt build-native.cmake
        Containerfile.native lazy-wpe-egl.candidate.patch no-libdrm-snapshot.candidate.patch ../apply-patches.cmake ../cache.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" hash)
    string(APPEND identity ";${recipe}=${hash}")
endforeach()
string(SHA256 hash "${identity}")
set(key "webkit-m0-native-${hash}")
set(entry "${cache}/${key}")
get_filename_component(settings_directory "${KOBALT_WEBKIT_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${settings_directory}")
set(settings "")
kobalt_settings_line(settings KOBALT_WEBKIT_OUTPUT "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_DOWNLOADS "${cache}/downloads")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS 4)
kobalt_settings_line(settings KOBALT_WEBKIT_LAZY_EGL "${KOBALT_WEBKIT_LAZY_EGL}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake" "${settings}")
# Record the selected entry before building so a long-running build is inspectable.
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}"
    "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake")

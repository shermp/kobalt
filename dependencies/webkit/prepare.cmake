cmake_minimum_required(VERSION 3.22)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
foreach(manifest sources.json host-tools.json)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/${manifest}" pins)
    string(JSON count LENGTH "${pins}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON name MEMBER "${pins}" ${index})
        string(JSON url GET "${pins}" "${name}" url)
        string(JSON hash GET "${pins}" "${name}" sha256)
        kobalt_dependency_archive("${cache}/downloads" "${name}" "${url}" "${hash}" archive)
        if(name STREQUAL "wpewebkit")
            continue()
        endif()
        set(destination "${root}/build/webkit/tools/${name}-${hash}")
        if(NOT EXISTS "${destination}/complete")
            if(EXISTS "${destination}")
                message(FATAL_ERROR "Incomplete tools: clean ${destination} with platforms/cleanup.cmake")
            endif()
            file(MAKE_DIRECTORY "${destination}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
            file(WRITE "${destination}/complete" "${hash}\n")
        endif()
        string(JSON directory GET "${pins}" "${name}" directory)
        if(NOT IS_DIRECTORY "${destination}/${directory}")
            message(FATAL_ERROR "Missing extracted tool ${name}")
        endif()
        file(WRITE "${root}/build/webkit/${name}.txt" "${destination}/${directory}\n")
    endforeach()
endforeach()

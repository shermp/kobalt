set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KOBALT_WEBKIT_TOOLCHAIN KOBALT_WEBKIT_PREFIX)

set(triple arm-kobov4-linux-gnueabihf)
set(bin "${KOBALT_WEBKIT_TOOLCHAIN}/bin/${triple}")
set(CMAKE_C_COMPILER "${bin}-gcc")
set(CMAKE_CXX_COMPILER "${bin}-g++")
set(CMAKE_SYSROOT "${KOBALT_WEBKIT_TOOLCHAIN}/${triple}/sysroot")
set(CMAKE_FIND_ROOT_PATH "${KOBALT_WEBKIT_PREFIX}" "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")

if(NOT IS_ABSOLUTE "${KOBALT_WEBKIT_OUTPUT_FILE}" OR NOT IS_ABSOLUTE "${KOBALT_WEBKIT_GLIB_ENTRY}")
    message(FATAL_ERROR "Pass absolute KOBALT_WEBKIT_OUTPUT_FILE and KOBALT_WEBKIT_GLIB_ENTRY")
endif()
if(NOT EXISTS "${KOBALT_WEBKIT_GLIB_ENTRY}/complete")
    message(FATAL_ERROR "Build FW4 GLib before reusing its verified toolchain")
endif()
set(toolchain "${KOBALT_WEBKIT_GLIB_ENTRY}/sources/kobov4/arm-kobov4-linux-gnueabihf")
set(KOBALT_WEBKIT_JOBS 4 CACHE STRING "Jobs for each dependency build")
if(NOT KOBALT_WEBKIT_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "KOBALT_WEBKIT_JOBS must be positive")
endif()
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
get_filename_component(glib_key "${KOBALT_WEBKIT_GLIB_ENTRY}" NAME)
set(identity "${glib_key};${CMAKE_VERSION};${KOBALT_WEBKIT_BUILD_IMAGE}")
foreach(recipe build-text.cmake fw4-toolchain.cmake text/CMakeLists.txt ../cache.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" hash)
    string(APPEND identity ";${hash}")
endforeach()
set(settings "")
foreach(name icu harfbuzz)
    if(name STREQUAL icu)
        file(READ "${CMAKE_CURRENT_LIST_DIR}/text/sources.json" sources)
    else()
        file(READ "${root}/dependencies/manifest.json" sources)
    endif()
    string(JSON url GET "${sources}" "${name}" url)
    string(JSON hash GET "${sources}" "${name}" sha256)
    kobalt_dependency_archive("${cache}/downloads" "${name}" "${url}" "${hash}" archive)
    string(TOUPPER "${name}" upper)
    kobalt_settings_line(settings "KOBALT_WEBKIT_${upper}_ARCHIVE" "${archive}")
    kobalt_settings_line(settings "KOBALT_WEBKIT_${upper}_SHA256" "${hash}")
    string(APPEND identity ";${hash}")
endforeach()

string(SHA256 hash "${identity}")
set(key "webkit-fw4-text-${hash}")
set(entry "${cache}/${key}")
get_filename_component(output_directory "${KOBALT_WEBKIT_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
kobalt_settings_line(settings KOBALT_WEBKIT_ENTRY "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_TOOLCHAIN "${toolchain}")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS "${KOBALT_WEBKIT_JOBS}")
set(settings_path "${KOBALT_WEBKIT_OUTPUT_FILE}.cmake")
file(WRITE "${settings_path}" "${settings}")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}/text" "${settings_path}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")

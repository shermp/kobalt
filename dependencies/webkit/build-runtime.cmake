cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")

foreach(path KOBALT_WEBKIT_OUTPUT_FILE KOBALT_WEBKIT_GLIB_ENTRY KOBALT_WEBKIT_TEXT_ENTRY)
    if(NOT IS_ABSOLUTE "${${path}}")
        message(FATAL_ERROR "Pass an absolute ${path}")
    endif()
endforeach()
if(NOT EXISTS "${KOBALT_WEBKIT_GLIB_ENTRY}/complete" OR NOT EXISTS "${KOBALT_WEBKIT_TEXT_ENTRY}/complete")
    message(FATAL_ERROR "Build FW4 GLib and text dependencies first")
endif()
set(KOBALT_WEBKIT_JOBS 4 CACHE STRING "Jobs for each dependency build")
if(NOT KOBALT_WEBKIT_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "KOBALT_WEBKIT_JOBS must be positive")
endif()

kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
get_filename_component(glib_key "${KOBALT_WEBKIT_GLIB_ENTRY}" NAME)
get_filename_component(text_key "${KOBALT_WEBKIT_TEXT_ENTRY}" NAME)
set(identity "${glib_key};${text_key};${CMAKE_VERSION};${KOBALT_WEBKIT_BUILD_IMAGE}")
foreach(recipe build-runtime.cmake fw4-toolchain.cmake runtime/CMakeLists.txt runtime/cross.ini.in ../cache.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" hash)
    string(APPEND identity ";${hash}")
endforeach()

file(READ "${CMAKE_CURRENT_LIST_DIR}/runtime/sources.json" runtime_sources)
file(READ "${root}/dependencies/manifest.json" application_sources)
string(JSON count LENGTH "${runtime_sources}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON name MEMBER "${runtime_sources}" "${index}")
    list(APPEND names "${name}")
endforeach()
list(APPEND names freetype jpeg png)
set(settings "")
foreach(name IN LISTS names)
    set(manifest "${runtime_sources}")
    set(input "${name}")
    if(name STREQUAL freetype OR name STREQUAL jpeg OR name STREQUAL png)
        set(manifest "${application_sources}")
        if(name STREQUAL jpeg)
            set(input libjpeg-turbo)
        elseif(name STREQUAL png)
            set(input libpng)
        endif()
    endif()
    string(JSON url GET "${manifest}" "${input}" url)
    string(JSON hash GET "${manifest}" "${input}" sha256)
    string(REGEX MATCH "^https://snapshot.ubuntu.com/.*/([^/]+)$" ubuntu_source "${url}")
    if(ubuntu_source)
        set(input "ubuntu-${CMAKE_MATCH_1}")
    endif()
    kobalt_dependency_archive("${cache}/downloads" "${input}" "${url}" "${hash}" archive)
    kobalt_settings_line(settings "KOBALT_WEBKIT_${name}_ARCHIVE" "${archive}")
    kobalt_settings_line(settings "KOBALT_WEBKIT_${name}_SHA256" "${hash}")
    string(APPEND identity ";${name}=${hash}")
endforeach()
string(SHA256 hash "${identity}")
set(key "webkit-fw4-runtime-${hash}")
set(entry "${cache}/${key}")
get_filename_component(output_directory "${KOBALT_WEBKIT_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
kobalt_settings_line(settings KOBALT_WEBKIT_ENTRY "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_GLIB_PREFIX "${KOBALT_WEBKIT_GLIB_ENTRY}/install")
kobalt_settings_line(settings KOBALT_WEBKIT_TEXT_PREFIX "${KOBALT_WEBKIT_TEXT_ENTRY}/install")
kobalt_settings_line(settings KOBALT_WEBKIT_TOOLCHAIN "${KOBALT_WEBKIT_GLIB_ENTRY}/sources/kobov4/arm-kobov4-linux-gnueabihf")
kobalt_settings_line(settings KOBALT_WEBKIT_MESON "${KOBALT_WEBKIT_GLIB_ENTRY}/sources/meson")
kobalt_settings_line(settings KOBALT_WEBKIT_RUNTIME_SOURCES "${names}")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS "${KOBALT_WEBKIT_JOBS}")
set(settings_path "${KOBALT_WEBKIT_OUTPUT_FILE}.cmake")
file(WRITE "${settings_path}" "${settings}")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}/runtime" "${settings_path}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")

cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")
file(READ "${CMAKE_CURRENT_LIST_DIR}/build-image.json" lock)
string(JSON image GET "${lock}" image)
if(NOT KOBALT_WEBKIT_BUILD_IMAGE STREQUAL image)
    message(FATAL_ERROR "WebKit requires the exact prepared image ${image}")
endif()
if(NOT KOBALT_WEBKIT_OUTPUT_FILE OR NOT DEFINED ENV{KOBALT_WEBKIT_TOOLCHAIN})
    message(FATAL_ERROR "Use platforms/webkit/build.sh")
endif()
set(KOBALT_WEBKIT_JOBS 4 CACHE STRING "Parallel WebKit compiler jobs")
if(NOT KOBALT_WEBKIT_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "KOBALT_WEBKIT_JOBS must be positive")
endif()
kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
set(identity "webkit-armhf;${image};${CMAKE_VERSION}")
file(GLOB_RECURSE inputs LIST_DIRECTORIES FALSE "${CMAKE_CURRENT_LIST_DIR}/*")
list(APPEND inputs "${root}/dependencies/cache.cmake" "${root}/dependencies/apply-patches.cmake")
list(SORT inputs)
foreach(path IN LISTS inputs)
    file(SHA256 "${path}" hash)
    file(RELATIVE_PATH name "${root}/dependencies" "${path}")
    string(APPEND identity ";${name}=${hash}")
endforeach()
string(SHA256 hash "${identity}")
set(key "webkit-armhf-${hash}")
set(entry "${cache}/${key}")
set(settings "")
kobalt_settings_line(settings KOBALT_WEBKIT_OUTPUT "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_DOWNLOADS "${cache}/downloads")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS "${KOBALT_WEBKIT_JOBS}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake" "${settings}")
set(ENV{DESTDIR} "${entry}/install")
set(ENV{CMAKE_TOOLCHAIN_FILE} "${CMAKE_CURRENT_LIST_DIR}/arm.cmake")
string(JSON epoch GET "${lock}" source_date_epoch)
set(ENV{SOURCE_DATE_EPOCH} "${epoch}")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}"
    "${KOBALT_WEBKIT_OUTPUT_FILE}.settings.cmake")
# Write the selected entry only after successful publication.
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")

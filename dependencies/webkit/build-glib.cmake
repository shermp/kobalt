cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dependencies/cache.cmake")

if(NOT KOBALT_WEBKIT_BUILD_IMAGE MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Pass the exact local build image ID without its sha256 prefix")
endif()
string(LENGTH "${KOBALT_WEBKIT_BUILD_IMAGE}" image_id_length)
if(NOT image_id_length EQUAL 64)
    message(FATAL_ERROR "Pass the full image ID")
endif()
set(KOBALT_WEBKIT_JOBS "4" CACHE STRING "Jobs for each dependency build")
if(NOT KOBALT_WEBKIT_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "KOBALT_WEBKIT_JOBS must be positive")
endif()
if(NOT IS_ABSOLUTE "${KOBALT_WEBKIT_OUTPUT_FILE}")
    message(FATAL_ERROR "Pass an absolute KOBALT_WEBKIT_OUTPUT_FILE in the worktree build directory")
endif()

kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" cache)
set(identity "${KOBALT_WEBKIT_BUILD_IMAGE};${CMAKE_VERSION}")
foreach(recipe CMakeLists.txt build-glib.cmake fw4-toolchain.cmake glib-cross.ini.in sources.json ../cache.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" hash)
    string(APPEND identity ";${recipe}=${hash}")
endforeach()
file(READ "${CMAKE_CURRENT_LIST_DIR}/sources.json" sources)
foreach(name kobov4 meson zlib pcre2 libffi glib)
    string(JSON url GET "${sources}" "${name}" url)
    string(JSON hash GET "${sources}" "${name}" sha256)
    kobalt_dependency_archive("${cache}/downloads" "${name}" "${url}" "${hash}" archive)
endforeach()

string(SHA256 hash "${identity}")
set(key "webkit-fw4-glib-${hash}")
set(entry "${cache}/${key}")
get_filename_component(output_directory "${KOBALT_WEBKIT_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
set(settings "")
kobalt_settings_line(settings KOBALT_WEBKIT_ENTRY "${entry}")
kobalt_settings_line(settings KOBALT_WEBKIT_DOWNLOADS "${cache}/downloads")
kobalt_settings_line(settings KOBALT_WEBKIT_JOBS "${KOBALT_WEBKIT_JOBS}")
set(settings_path "${KOBALT_WEBKIT_OUTPUT_FILE}.cmake")
file(WRITE "${settings_path}" "${settings}")
kobalt_dependency_set("${cache}" "${key}" "${CMAKE_CURRENT_LIST_DIR}" "${settings_path}")
file(WRITE "${KOBALT_WEBKIT_OUTPUT_FILE}" "${entry}\n")

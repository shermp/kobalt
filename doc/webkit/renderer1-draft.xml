<?xml version="1.0" encoding="UTF-8"?>
<!-- Proposed *independent* WPE-M3 renderer IPC schema for this new project.
     No association with the Kobalt upstream C++ Engine ABI.
     Do not freeze until WPE-M3 design review; version breaking changes after release.
     Each successful visual method atomically returns a{sv} state and immutable
     FD-backed pixel buffer. The state must identify request, document and layout
     generations, frame revision and source locator; Qt verifies that it matches
     its pending operation. A Unix-D-Bus `h` is an FD-list index, not the sender's
     raw descriptor number. The renderer's source locator is not automatically
     Kobalt's canonical `Location`; WPE-M4 proves that conversion. -->
<node name="/org/kobalt/Renderer1">
  <interface name="org.kobalt.Renderer1">
    <method name="Hello">
      <arg name="clientVersion" type="u" direction="in"/>
      <arg name="protocolVersion" type="u" direction="out"/>
      <arg name="capabilities" type="a{sv}" direction="out"/>
    </method>
    <method name="Open">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="absolutePath" type="s" direction="in"/>
      <arg name="fingerprint" type="s" direction="in"/>
      <arg name="width" type="u" direction="in"/>
      <arg name="height" type="u" direction="in"/>
      <arg name="appearance" type="a{sv}" direction="in"/>
      <arg name="savedToken" type="s" direction="in"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <arg name="frameFd" type="h" direction="out"/>
      <arg name="frameWidth" type="u" direction="out"/>
      <arg name="frameHeight" type="u" direction="out"/>
      <arg name="frameStride" type="u" direction="out"/>
      <arg name="frameFormat" type="s" direction="out"/>
    </method>
    <method name="Close">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
    </method>
    <method name="SetAppearance">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="appearance" type="a{sv}" direction="in"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <arg name="frameFd" type="h" direction="out"/>
      <arg name="frameWidth" type="u" direction="out"/>
      <arg name="frameHeight" type="u" direction="out"/>
      <arg name="frameStride" type="u" direction="out"/>
      <arg name="frameFormat" type="s" direction="out"/>
    </method>
    <method name="SetViewport">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="width" type="u" direction="in"/>
      <arg name="height" type="u" direction="in"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <arg name="frameFd" type="h" direction="out"/>
      <arg name="frameWidth" type="u" direction="out"/>
      <arg name="frameHeight" type="u" direction="out"/>
      <arg name="frameStride" type="u" direction="out"/>
      <arg name="frameFormat" type="s" direction="out"/>
    </method>
    <method name="Turn">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="delta" type="i" direction="in"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <arg name="frameFd" type="h" direction="out"/>
      <arg name="frameWidth" type="u" direction="out"/>
      <arg name="frameHeight" type="u" direction="out"/>
      <arg name="frameStride" type="u" direction="out"/>
      <arg name="frameFormat" type="s" direction="out"/>
    </method>
    <method name="Navigate">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="kind" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <arg name="frameFd" type="h" direction="out"/>
      <arg name="frameWidth" type="u" direction="out"/>
      <arg name="frameHeight" type="u" direction="out"/>
      <arg name="frameStride" type="u" direction="out"/>
      <arg name="frameFormat" type="s" direction="out"/>
    </method>
    <method name="Query">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="layoutRevision" type="t" direction="in"/>
      <arg name="kind" type="s" direction="in"/>
      <arg name="arguments" type="a{sv}" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="BuildPageIndex">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="documentId" type="t" direction="in"/>
      <arg name="jobId" type="t" direction="out"/>
    </method>
    <method name="Cancel">
      <arg name="targetRequestId" type="t" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="Shutdown"/>
    <signal name="PageIndexUpdated">
      <arg name="documentId" type="t"/>
      <arg name="layoutRevision" type="t"/>
      <arg name="jobId" type="t"/>
      <arg name="spinesDone" type="u"/>
      <arg name="spinesTotal" type="u"/>
      <arg name="wholeBookPages" type="i"/>
      <arg name="status" type="s"/>
    </signal>
    <signal name="RendererError">
      <arg name="documentId" type="t"/>
      <arg name="code" type="s"/>
      <arg name="message" type="s"/>
    </signal>
    <signal name="RendererStateChanged">
      <arg name="state" type="s"/>
    </signal>
  </interface>
</node>
